<%- include('partials/head') %>
<h1 class="page-title"><%= t('Notifications') %></h1>
<%# shown by public/js/push.js when this device could get phone notifications but doesn't %>
<p id="push-hint" class="push-hint" hidden><%= t('Want these on your phone, even with BookFriends closed?') %> <a href="/settings#push"><%= t('Turn on phone notifications') %></a></p>
<% if (items.length === 0) { %>
  <p class="empty"><%= t('Nothing here yet — when a friend replies to one of your comments, it shows up here.') %></p>
<% } %>
<div class="notif-list">
  <% for (const n of items) { %>
    <a class="notif<%= n.seen ? '' : ' unseen' %>" href="<%= n.link %>">
      <div class="notif-title"><strong><%= n.replierName %></strong> <%= t('replied to your comment') %></div>
      <div class="notif-meta"><%= n.book_title %> — <%= n.chapter_title %><%= n.para_index === null ? '' : ' · ' + t('paragraph {n}', { n: n.para_index + 1 }) %> · <%= n.when %></div>
      <div class="notif-excerpt"><%= n.excerpt %></div>
    </a>
  <% } %>
</div>
<script src="/js/push.js?v=<%= assetVersion %>"></script>
<%- include('partials/footer') %>
