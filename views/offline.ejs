<%- include('partials/head') %>
<div class="form-card offline-card">
  <img class="auth-logo" src="/android-chrome-192x192.png?v=<%= assetVersion %>" alt="">
  <h1><%= t("You're offline") %></h1>
  <p><%= t("This page isn't saved on this device. The chapters you opened recently, and the next few after each one, can be read without a connection.") %></p>
  <div class="offline-actions">
    <a class="btn" href="/"><%= t('Back to the shelf') %></a>
    <button class="btn btn-ghost" type="button" onclick="location.reload()"><%= t('Try again') %></button>
  </div>
</div>
<%- include('partials/footer') %>
