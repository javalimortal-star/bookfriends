<%- include('partials/head') %>
<h1 class="page-title"><%= t('Users') %></h1>
<% if (resetInfo) { %>
  <div class="reset-banner">
    <%= t('Temporary password for') %> <strong><%= resetInfo.email %></strong>: <code><%= resetInfo.temp %></code><br>
    <%= t('Send it to them — they log in with it and can change it in Settings. It is shown only this once.') %>
  </div>
<% } %>
<% if (error) { %><p class="form-error"><%= error %></p><% } %>
<div class="table-wrap">
  <table class="users-table">
    <thead><tr><th><%= t('Email') %></th><th><%= t('Name') %></th><th><%= t('Role') %></th><th><%= t('Login') %></th><th><%= t('Joined') %></th><th></th></tr></thead>
    <tbody>
      <% for (const u of users) { %>
        <tr>
          <td><%= u.email %></td>
          <td><%= u.display_name || '—' %></td>
          <td><%= u.role === 'owner' ? t('Owner') : t('Reader') %></td>
          <td><%= u.auth_provider === 'google' ? 'Google' : t('Email') %></td>
          <td><%= new Date(u.created_at).toLocaleDateString(locale) %></td>
          <td>
            <% if (u.auth_provider === 'local' && u.id !== user.id) { %>
              <form method="post" action="/users/<%= u.id %>/reset-password" class="inline-form" onsubmit="return confirm(<%= JSON.stringify(t('Reset the password for {email}? Their current password stops working.', { email: u.email })) %>)">
                <button class="btn btn-small btn-ghost" type="submit"><%= t('Reset password') %></button>
              </form>
            <% } else if (u.auth_provider !== 'local') { %>
              <span class="hint"><%= t('Google login') %></span>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
<p class="hint"><%= t('If a friend forgets their password, reset it here and send them the temporary one.') %></p>
<%- include('partials/footer') %>
