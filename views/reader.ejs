<%- include('partials/head', { bodyClass: 'reader-page' }) %>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Source+Serif+4:wght@400;600&family=Inter:wght@400;600&family=Merriweather:wght@400;700&family=Lato:wght@400;700&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
<div class="reader-titlebar">
  <a class="titlebar-back" href="/" title="<%= t('Back to shelf') %>">‹</a>
  <% if (book.cover_path) { %><img class="titlebar-cover" src="/media/book/<%= book.id %>/cover" alt=""><% } %>
  <div class="titlebar-text">
    <div class="titlebar-book"><%= book.title %></div>
    <div class="titlebar-chapter"><%= chapter.title %></div>
  </div>
  <div class="titlebar-nav">
    <a class="chapter-arrow titlebar-search" href="/book/<%= book.slug %>/search?from=<%= chapter.idx %>" title="<%= t('Search in this book') %>" aria-label="<%= t('Search in this book') %>"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg></a>
    <% if (prevIdx !== null) { %><a class="chapter-arrow" href="/book/<%= book.slug %>/<%= prevIdx %>" title="<%= t('Previous chapter') %>">‹</a><% } else { %><span class="chapter-arrow disabled">‹</span><% } %>
    <% if (nextIdx !== null) { %><a class="chapter-arrow" href="/book/<%= book.slug %>/<%= nextIdx %>" title="<%= t('Next chapter') %>">›</a><% } else { %><span class="chapter-arrow disabled">›</span><% } %>
  </div>
</div>

<article id="chapter-content" class="chapter-content"><%- chapter.content_html %></article>

<div class="chapter-end">
  <% if (bookmark && bookmark.action === 'advanced') { %>
    <div id="bm-banner" class="bm-banner">
      <span class="bm-icon bm-icon-ok">✓</span>
      <span class="bm-text"><%= t('Chapter bookmarked!') %></span>
      <button type="button" id="bm-undo" class="bm-action"><%= t('Undo') %></button>
    </div>
  <% } else if (bookmark && bookmark.action === 'older') { %>
    <div id="bm-banner" class="bm-banner">
      <span class="bm-icon bm-icon-warn">⚠</span>
      <span class="bm-text"><%= t('You are reading an older chapter than the one you have bookmarked.') %></span>
      <button type="button" id="bm-set" class="bm-action"><%= t('Bookmark') %></button>
    </div>
  <% } %>
  <% if (nextIdx !== null) { %>
    <a class="next-chapter-btn" href="/book/<%= book.slug %>/<%= nextIdx %>"><%= t('NEXT CHAPTER') %></a>
  <% } %>
  <% if (friends.length > 0) { %>
    <section class="friends-strip" aria-labelledby="friends-strip-title">
      <h2 id="friends-strip-title" class="friends-strip-title"><%= t('Friends reading this book') %></h2>
      <% if (friendsHere > 0) { %>
        <p class="friends-here"><%= t.n('{names} is reading this chapter too', '{names} are reading this chapter too', friendsHere, { names: friendsHereNames }) %></p>
      <% } %>
      <ul class="friend-chips">
        <% for (const f of friends) { %>
          <li class="friend-chip<%= f.chapterIdx === chapter.idx ? ' here' : '' %>" title="<%= f.when %>">
            <span class="friend-avatar avatar-<%= f.tone %>" aria-hidden="true"><%= f.initial %></span>
            <span class="friend-chip-name"><%= f.name %></span>
            <span class="friend-chip-ch"><%= f.chapterIdx === chapter.idx ? t('this chapter') : t('ch. {n}', { n: f.chapter }) %></span>
          </li>
        <% } %>
      </ul>
    </section>
  <% } %>
  <section id="comments" class="chapter-comments">
    <div class="comments-header">
      <h2 id="chapter-comments-title"><%= t.n('{count} comment', '{count} comments', chapterCommentCount) %></h2>
      <select id="chapter-sort" class="sort-select" aria-label="<%= t('Sort comments') %>">
        <option value="top"><%= t('Top') %></option>
        <option value="new"><%= t('Newest') %></option>
      </select>
    </div>
    <div id="chapter-comment-form"></div>
    <div id="chapter-comment-list" class="comment-list"></div>
  </section>
</div>

<div id="panel-backdrop" class="panel-backdrop" hidden></div>
<aside id="comment-panel" class="comment-panel" hidden aria-label="<%= t('Paragraph comments') %>">
  <div class="panel-header">
    <span id="panel-title"><%= t('Comments') %></span>
    <select id="panel-sort" class="sort-select" aria-label="<%= t('Sort comments') %>">
      <option value="top"><%= t('Top') %></option>
      <option value="new"><%= t('Newest') %></option>
    </select>
    <button id="panel-close" class="panel-close" aria-label="<%= t('Close') %>">×</button>
  </div>
  <div id="panel-form"></div>
  <div id="panel-list" class="comment-list"></div>
</aside>

<div id="font-panel" class="font-panel" hidden>
  <div class="font-panel-label"><%= t('Font') %></div>
  <div class="font-grid">
    <button type="button" class="font-choice" data-font="opensans">Opensans</button>
    <button type="button" class="font-choice" data-font="sourceserif">Source serif</button>
    <button type="button" class="font-choice" data-font="inter">Inter</button>
    <button type="button" class="font-choice" data-font="merriweather">Merriweather</button>
    <button type="button" class="font-choice" data-font="lato">Lato</button>
    <button type="button" class="font-choice" data-font="montserrat">Montserrat</button>
  </div>
  <div class="font-panel-row">
    <span class="font-panel-label"><%= t('Text size') %></span>
    <div class="stepper">
      <button type="button" id="size-minus" class="stepper-btn" aria-label="<%= t('Smaller text') %>">−</button>
      <span id="size-value" class="stepper-value">20</span>
      <button type="button" id="size-plus" class="stepper-btn" aria-label="<%= t('Larger text') %>">+</button>
    </div>
  </div>
  <div class="font-panel-row">
    <span class="font-panel-label"><%= t('Line height') %></span>
    <div class="stepper">
      <button type="button" id="lh-minus" class="stepper-btn" aria-label="<%= t('Tighter lines') %>">−</button>
      <span id="lh-value" class="stepper-value">24</span>
      <button type="button" id="lh-plus" class="stepper-btn" aria-label="<%= t('Looser lines') %>">+</button>
    </div>
  </div>
  <div class="font-panel-label"><%= t('Contrast') %></div>
  <div class="contrast-row">
    <button type="button" id="contrast-normal" class="contrast-btn" aria-label="<%= t('Normal contrast') %>">✓</button>
    <button type="button" id="contrast-high" class="contrast-btn contrast-a" aria-label="<%= t('High contrast') %>">A</button>
  </div>
  <div class="font-panel-label"><%= t('Color') %></div>
  <div class="theme-row">
    <button type="button" class="theme-btn" data-theme="dark"><%= t('Dark') %></button>
    <button type="button" class="theme-btn" data-theme="light"><%= t('Light') %></button>
    <button type="button" class="theme-btn" data-theme="sepia"><%= t('Sepia') %></button>
  </div>
  <button type="button" id="font-reset" class="font-reset"><%= t('RESET') %></button>
</div>

<div class="reader-bottombar">
  <button type="button" id="badges-toggle" class="bar-btn" aria-pressed="true" title="<%= t('Show/hide paragraph comments') %>">P</button>
  <button type="button" id="font-toggle" class="bar-btn" aria-expanded="false" title="<%= t('Font options') %>">tT</button>
  <select id="toc-select" class="sort-select toc-select" aria-label="<%= t('Table of contents') %>">
    <% for (const item of toc) { %>
      <option value="/book/<%= book.slug %>/<%= item.idx %>" <%= item.idx === chapter.idx ? 'selected' : '' %>><%= bookmark && item.idx <= bookmark.bmIdx ? '✓ ' : '' %><%= item.title %></option>
    <% } %>
  </select>
  <% if (prevIdx !== null) { %><a class="chapter-arrow" href="/book/<%= book.slug %>/<%= prevIdx %>" title="<%= t('Previous chapter') %>">‹<span class="bar-label"><%= t('Prev') %></span></a><% } else { %><span class="chapter-arrow disabled">‹<span class="bar-label"><%= t('Prev') %></span></span><% } %>
  <% if (nextIdx !== null) { %><a class="chapter-arrow" href="/book/<%= book.slug %>/<%= nextIdx %>" title="<%= t('Next chapter') %>"><span class="bar-label"><%= t('Next') %></span>›</a><% } else { %><span class="chapter-arrow disabled"><span class="bar-label"><%= t('Next') %></span>›</span><% } %>
</div>

<script>
  window.__I18N__ = <%- clientI18n %>;
  window.__READER__ = {
    chapterId: <%= chapter.id %>,
    bookId: <%= book.id %>,
    chapterIdx: <%= chapter.idx %>,
    prevUrl: <%- JSON.stringify(prevIdx !== null ? '/book/' + book.slug + '/' + prevIdx : null) %>,
    nextUrl: <%- JSON.stringify(nextIdx !== null ? '/book/' + book.slug + '/' + nextIdx : null) %>,
    bookmark: <%- JSON.stringify(bookmark) %>,
    badgeCounts: <%- JSON.stringify(badgeCounts) %>,
    user: <%- JSON.stringify(user ? { id: user.id, role: user.role } : null) %>
  };
</script>
<script src="/js/reader.js?v=<%= assetVersion %>"></script>
<%- include('partials/footer') %>
