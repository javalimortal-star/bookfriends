<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %></title>
  <%- include('meta') %>
  <script>
    try {
      var themePref = JSON.parse(localStorage.getItem('bf-reader-settings') || '{}').theme;
      if (themePref === 'light' || themePref === 'sepia') document.documentElement.className = 'theme-' + themePref;
    } catch (e) { /* default dark */ }
  </script>
  <style>
    /* Painted before app.css arrives — no white flash between pages */
    html { background: #050505; color: #ececec; }
    html.theme-light { background: #f9f9f9; color: #2b3040; }
    html.theme-sepia { background: #f3e9d2; color: #4a3b26; }
  </style>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=<%= assetVersion %>">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=<%= assetVersion %>">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=<%= assetVersion %>">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#050505">
</head>
<body<% if (typeof bodyClass !== 'undefined') { %> class="<%= bodyClass %>"<% } %>>
<% const navName = user ? displayName(user) : ''; %>
<nav class="nav">
  <a class="nav-brand" href="/"><img class="nav-logo" src="/logo.webp?v=<%= assetVersion %>" alt="">BookFriends</a>
  <div class="nav-right">
    <% if (user) { %>
      <% if (user.role === 'owner') { %>
        <a class="btn btn-small nav-wide" href="/upload"><%= t('Upload') %></a>
        <a class="btn btn-small btn-ghost nav-wide" href="/users"><%= t('Users') %></a>
      <% } %>
      <a class="nav-bell" href="/notifications" title="<%= t('Notifications') %>" aria-label="<%= t('Notifications') %>"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg><% if (unseenNotifs > 0) { %><span class="bell-badge"><%= unseenNotifs > 9 ? '9+' : unseenNotifs %></span><% } %></a>
      <details class="nav-menu">
        <summary class="nav-avatar" title="<%= navName %>" aria-label="<%= t('Account menu') %>"><%= navName.charAt(0).toUpperCase() %><% if (locals.backupAlert) { %><span class="avatar-dot" aria-hidden="true"></span><% } %></summary>
        <div class="nav-menu-list">
          <div class="nav-menu-head"><strong><%= navName %></strong><span><%= user.email %></span></div>
          <% if (locals.backupAlert) { %><a class="nav-menu-item nav-menu-alert" href="/users#backups"><%= t('Backups need attention') %></a><% } %>
          <a class="nav-menu-item" href="/settings"><%= t('Settings') %></a>
          <a class="nav-menu-item" href="/requests"><%= t('Book requests') %><% if (typeof openRequests !== 'undefined' && openRequests > 0) { %> <span class="menu-badge" title="<%= t.n('{count} open request', '{count} open requests', openRequests) %>"><%= openRequests %></span><% } %></a>
          <% if (user.role === 'owner') { %>
            <a class="nav-menu-item nav-narrow" href="/upload"><%= t('Upload a book') %></a>
            <a class="nav-menu-item nav-narrow" href="/users"><%= t('Users') %></a>
          <% } %>
          <form method="post" action="/logout"><button class="nav-menu-item" type="submit"><%= t('Log out') %></button></form>
        </div>
      </details>
    <% } else { %>
      <a class="btn btn-small btn-ghost" href="/login"><%= t('Log in') %></a>
      <a class="btn btn-small" href="/register"><%= t('Register') %></a>
    <% } %>
  </div>
</nav>
<main class="main">
