</main>
<footer class="site-footer">
  <nav class="lang-switch" aria-label="<%= t('Language') %>">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
    <% for (const l of languages) { %>
      <% if (l.code === lang) { %><span class="lang-current" aria-current="true"><%= l.name %></span><% } else { %><a href="/lang/<%= l.code %>?next=<%= encodeURIComponent(currentUrl) %>" hreflang="<%= l.code %>" lang="<%= l.code %>"><%= l.name %></a><% } %>
    <% } %>
  </nav>
</footer>
<script>
  // The account menu is a <details>: also close it on outside clicks and Escape
  (function () {
    var menu = document.querySelector('.nav-menu');
    if (!menu) return;
    document.addEventListener('click', function (event) {
      if (menu.open && !menu.contains(event.target)) menu.open = false;
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary').focus();
      }
    });
  })();
</script>
<div id="offline-banner" class="offline-banner" role="status" hidden><%= t("You're offline — showing saved chapters") %></div>
<script>
  // Offline reading and phone notifications: the service worker (public/sw.js)
  // saves chapters, this tells it what is happening on the page.
  (function () {
    var banner = document.getElementById('offline-banner');
    var main = document.querySelector('.main');
    // top of the page; in the reader under the chapter title (clear of its bars)
    var titlebar = document.querySelector('.reader-titlebar');
    if (titlebar) titlebar.parentNode.insertBefore(banner, titlebar.nextSibling);
    else if (main) main.insertBefore(banner, main.firstChild);
    function syncOnline() {
      var offline = navigator.onLine === false;
      banner.hidden = !offline;
      document.body.classList.toggle('is-offline', offline);
    }
    syncOnline();
    window.addEventListener('online', syncOnline);
    window.addEventListener('offline', syncOnline);

    if (!('serviceWorker' in navigator)) return;
    <% if (!swEnabled) { %>
    // SW_DISABLED=1 on the server: remove the worker and everything it saved
    navigator.serviceWorker.getRegistrations().then(function (regs) {
      regs.forEach(function (reg) { reg.unregister(); });
    }).catch(function () {});
    if (window.caches) {
      caches.keys().then(function (names) {
        names.forEach(function (name) { if (name.indexOf('bf-') === 0) caches.delete(name); });
      }).catch(function () {});
    }
    return;
    <% } %>
    navigator.serviceWorker.register('/sw.js').catch(function () {});
    // Which account the saved pages belong to ('' = logged out). When it
    // changes, the worker drops them: they show the previous account's name
    // and private books (and this device's notifications were theirs).
    // null on the offline page: it is saved logged out, whoever is reading.
    var KEY = 'bf-sw-account';
    var account = <%- typeof offlinePage !== 'undefined' && offlinePage ? 'null' : JSON.stringify(user ? String(user.id) : '') %>;
    var previous = null;
    var remembered = true;
    try { previous = localStorage.getItem(KEY); } catch (e) { remembered = false; }
    navigator.serviceWorker.ready.then(function (reg) {
      if (!reg.active) return;
      reg.active.postMessage({
        type: 'page',
        path: location.pathname,
        lang: document.documentElement.lang,
        online: navigator.onLine !== false,
        // without storage, play safe: purge whenever logged out
        purge: account !== null && (remembered ? previous !== null && previous !== account : account === ''),
        // notifications only go when someone else logs in on this device; a
        // plain logout (or an expired login) keeps them, the Log out button
        // below turns them off itself
        dropPush: account !== null && remembered && !!previous && !!account && previous !== account,
      });
      if (account === null) return;
      try { localStorage.setItem(KEY, account); } catch (e) { /* private mode */ }
    }).catch(function () {});
    // Log out on purpose: this device stops getting this account's
    // notifications (at most a 1.5 s wait, then the logout goes ahead).
    var logoutForm = document.querySelector('form[action="/logout"]');
    if (logoutForm) logoutForm.addEventListener('submit', function (event) {
      if (logoutForm.dataset.pushDone) return;
      event.preventDefault();
      var go = function () {
        if (logoutForm.dataset.pushDone) return;
        logoutForm.dataset.pushDone = '1';
        logoutForm.submit();
      };
      setTimeout(go, 1500);
      navigator.serviceWorker.ready.then(function (reg) {
        return reg.pushManager ? reg.pushManager.getSubscription() : null;
      }).then(function (sub) {
        if (!sub) return null;
        return fetch('/api/push/unsubscribe', {
          method: 'POST', keepalive: true,
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ endpoint: sub.endpoint }),
        }).catch(function () {}).then(function () { return sub.unsubscribe(); });
      }).catch(function () {}).then(go);
    });
  })();
</script>
</body>
</html>
