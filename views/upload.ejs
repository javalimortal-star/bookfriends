<%- include('partials/head') %>
<div class="form-card">
  <h1><%= t('Upload a book') %></h1>
  <% if (error) { %><p class="form-error"><%= error %></p><% } %>
  <form method="post" action="/upload" enctype="multipart/form-data">
    <label class="field">
      <span><%= t('EPUB file') %></span>
      <input type="file" name="epub" accept=".epub" required>
    </label>
    <button class="btn" type="submit"><%= t('Upload') %></button>
  </form>
  <p class="hint"><%- t('New books start <strong>private</strong> — only you can see them until you make them public.') %></p>
</div>
<%- include('partials/footer') %>
